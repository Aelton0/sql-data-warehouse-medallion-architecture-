USE DATAWAREHOUSE;

SELECT 
ic.cst_id,
ic.cst_key,
ic.cst_firstname,
ic.cst_lastname,
ic.cst_marital_status,
ic.cst_gndr,
ic.cst_create_date,
ec.bdate,
ec.gen,
pc.cntry
FROM silver_crm_cust_info AS ic
LEFT JOIN silver_erp_cust_az12 AS ec 
ON ic.cst_key = ec.cid
LEFT JOIN silver_erp_loc_a101 AS pc
ON ic.cst_key = pc.cid

